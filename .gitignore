# ── Photos brutes du shooting ────────────────────────────────────
# 49 Mo de JPEG pleine résolution, conservés dans Dropbox.
# Les WebP dérivés sont versionnés dans src/assets/photos/,
# le site se construit donc sans ce dossier.
src/images-site/

# ── Copies de travail des visuels ────────────────────────────────
# Barre oblique initiale obligatoire : sans elle, le motif attrape aussi
# public/images/, où vivent les photos de professeurs servies par le site.
/images/
temporary screenshots/
